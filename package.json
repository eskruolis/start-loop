{
  "name": "start-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ERP starter: Next.js + React + Tailwind + shadcn/ui, data in Postgres, Google Sheets or both.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "sheets:check": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/sheets-check.ts",
    "sheets:copy": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/sheets-to-postgres.ts",
    "prepare": "lefthook install || true",
    "db:server": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.6.0-beta.19",
    "google-auth-library": "11.3.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "postgres": "4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
