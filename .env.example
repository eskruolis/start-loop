# Copy to .env.local and fill in. Never commit .env files. Every variable: docs/ENVIRONMENT.md

# --- Auth (required) -----------------------------------------------------------
# 32+ random characters: run `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The address the app runs on
BETTER_AUTH_URL=http://localhost:3000

# --- Database --------------------------------------------------------------------
# Empty locally: `pnpm dev` starts its own Postgres (data in ~/.start-loop/<app>/postgres).
# Production: your Postgres URL, e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Where each module keeps its data ------------------------------------------------
# Default for every module: postgres | sheets | memory
DATA_SOURCE=postgres
# Per module (hybrid), e.g. keep sales in Google Sheets for now:
# DATA_SOURCE_SALES=sheets

# --- Google Sheets (only when a module uses sheets; setup in docs/DATA-SOURCES.md) -----
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
